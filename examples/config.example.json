{
  "panel": {
    "url": "https://panel.example.com",
    "token": "REMNAWAVE_API_TOKEN"
  },
  "bridges": "auto",
  "auto": {
    "profiles": [
      "RF-Bridge"
    ],
    "countries": []
  },
  "probe": {
    "port": 2053,
    "uuid": "vlessUuid служебного пользователя — заполнит bridge-guard setup",
    "username": "bridge-probe",
    "timeout": 12,
    "urls": [
      "https://1.1.1.1/cdn-cgi/trace",
      "https://api.ipify.org"
    ]
  },
  "thresholds": {
    "fail_n": 3,
    "ok_n": 3,
    "max_dead": 1
  },
  "failover": {
    "dns": {
      "provider": "cloudflare",
      "token_file": "/etc/bridge-guard/cloudflare.token",
      "zone": "example.com",
      "name": "bridge.example.com",
      "ttl": 60,
      "min_pool": 1
    },
    "hosts": {
      "match_addresses": [
        "bridge.example.com",
        "203.0.113.10",
        "203.0.113.20"
      ]
    }
  },
  "telegram": {
    "bot_token": "123456:TELEGRAM_BOT_TOKEN",
    "chat_id": 123456789,
    "proxy": ""
  },
  "heartbeat": {
    "url": "",
    "daily_summary": true,
    "summary_hour": 9
  },
  "paths": {
    "xray": "/opt/bridge-guard/xray",
    "state": "/var/lib/bridge-guard/state.json",
    "backups": "/var/lib/bridge-guard/backups"
  }
}
